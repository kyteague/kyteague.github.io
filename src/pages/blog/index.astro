---
import { getCollection } from "astro:content";
import WritingList from "../../components/WritingList.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`Writing — ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <main>
    <section
      class="site-shell border-b border-phosphor/20 pt-16 pb-12 sm:pt-20 sm:pb-16"
    >
      <p class="terminal-kicker">Archive index</p>
      <h1
        class="mt-4 max-w-[18ch] text-[clamp(2.75rem,5vw,4.75rem)] font-normal leading-[1.08] text-paper"
      >
        Ideas, notes &amp;<br />technical fieldwork<span class="text-phosphor"
          >.</span
        >
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        Writing on software systems, data, engineering leadership, and the
        decisions behind durable technology.
      </p>
    </section>
    <WritingList posts={posts} showAllLink={false} heading="All entries" />
  </main>
</BaseLayout>
