---
import { getCollection } from "astro:content";
import StructuredData from "../../components/StructuredData.astro";
import WritingList from "../../components/WritingList.astro";
import { BLOG_DESCRIPTION, SITE_AUTHOR, SITE_TITLE } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBlogTags } from "../../utils/blogTags";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = getBlogTags(posts);
const pageURL = new URL("/blog/", Astro.site).href;
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": pageURL,
  url: pageURL,
  name: `Writing by ${SITE_AUTHOR}`,
  description: BLOG_DESCRIPTION,
  inLanguage: "en-US",
  isPartOf: { "@id": new URL("/#website", Astro.site).href },
  author: { "@id": new URL("/#person", Astro.site).href },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/blog/${post.id}/`, Astro.site).href,
      name: post.data.title,
    })),
  },
};
---

<BaseLayout title={`Writing — ${SITE_TITLE}`} description={BLOG_DESCRIPTION}>
  <StructuredData slot="head" data={collectionSchema} />
  <main>
    <section
      class="site-shell border-b border-phosphor/20 pt-16 pb-12 sm:pt-20 sm:pb-16"
    >
      <p class="terminal-kicker">Archive index</p>
      <h1
        class="mt-4 max-w-[18ch] text-[clamp(2.75rem,5vw,4.75rem)] font-normal leading-[1.08] text-paper"
      >
        Ideas, notes &amp;<br />technical fieldwork<span class="text-phosphor"
          >.</span
        >
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        {BLOG_DESCRIPTION}
      </p>
      <a
        href="/blog/tags/"
        class="mt-6 inline-flex items-center gap-2 font-mono text-sm text-phosphor no-underline transition-colors hover:text-paper"
      >
        Browse {tags.length} topics <span aria-hidden="true">→</span>
      </a>
    </section>
    <WritingList posts={posts} showAllLink={false} heading="All entries" />
  </main>
</BaseLayout>
