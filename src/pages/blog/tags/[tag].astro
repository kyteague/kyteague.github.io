---
import { getCollection } from "astro:content";
import StructuredData from "../../../components/StructuredData.astro";
import WritingList from "../../../components/WritingList.astro";
import { SITE_AUTHOR, SITE_TITLE } from "../../../consts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getBlogTags, type BlogTag } from "../../../utils/blogTags";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return getBlogTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: tag,
  }));
}

type Props = BlogTag;

const tag = Astro.props;
const entryLabel = tag.posts.length === 1 ? "entry" : "entries";
const description = `${tag.posts.length} ${entryLabel} from ${SITE_AUTHOR} about ${tag.name}.`;
const pageURL = new URL(`/blog/tags/${tag.slug}/`, Astro.site).href;
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": pageURL,
  url: pageURL,
  name: `Writing about ${tag.name} by ${SITE_AUTHOR}`,
  description,
  inLanguage: "en-US",
  isPartOf: { "@id": new URL("/blog/", Astro.site).href },
  author: { "@id": new URL("/#person", Astro.site).href },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: tag.posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/blog/${post.id}/`, Astro.site).href,
      name: post.data.title,
    })),
  },
};
---

<BaseLayout
  title={`${tag.name} writing — ${SITE_TITLE}`}
  description={description}
>
  <StructuredData slot="head" data={collectionSchema} />
  <main>
    <section
      class="site-shell border-b border-phosphor/20 pt-16 pb-12 sm:pt-20 sm:pb-16"
    >
      <p class="terminal-kicker">Topic archive</p>
      <h1
        class="mt-4 max-w-[18ch] text-[clamp(2.75rem,5vw,4.75rem)] font-normal leading-[1.08] text-paper"
      >
        <span class="text-phosphor">#</span>{tag.name}<span
          class="text-phosphor">.</span
        >
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        {description}
      </p>
      <a
        href="/blog/tags/"
        class="mt-6 inline-flex items-center gap-2 font-mono text-sm text-phosphor no-underline transition-colors hover:text-paper"
      >
        <span aria-hidden="true">←</span> All topics
      </a>
    </section>
    <WritingList
      posts={tag.posts}
      showAllLink={false}
      heading={`${tag.posts.length} ${entryLabel}`}
    />
  </main>
</BaseLayout>
