---
import ButtonLink from "../../components/ButtonLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

import { Content, frontmatter } from "../../content/services/index.md";
const { title, description, headline, contactHeading, contactText } =
  frontmatter;
const services: {
  title: string;
  href: string;
  description: string;
  detail: string;
}[] = frontmatter.services;
---

<BaseLayout title={`${title} — Kyle Teague`} description={description}>
  <main class="site-shell py-16 sm:py-20">
    <p class="terminal-kicker">{title}</p>
    <h1
      class="mt-4 max-w-4xl text-[clamp(2.75rem,5vw,4.75rem)] font-normal leading-[1.08] text-paper"
    >
      {headline}<span class="text-phosphor">.</span>
    </h1>
    <div class="mt-6 max-w-3xl text-lg leading-relaxed text-muted">
      <Content />
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        services.map(({ title, href, description, detail }) => (
          <section class="terminal-border flex flex-col bg-panel p-6 sm:p-8">
            <h2 class="text-3xl font-normal text-paper">
              <a href={href} class="hover:text-phosphor">
                {title}
              </a>
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>
            <p class="mt-5 text-sm leading-relaxed text-muted">{detail}</p>
            <div class="mt-auto pt-8">
              <ButtonLink href={href} variant="secondary">
                Explore <span class="sr-only">{title}</span>services
              </ButtonLink>
            </div>
          </section>
        ))
      }
    </div>

    <section class="mt-12 border-t border-phosphor/20 pt-10">
      <h2 class="text-2xl text-paper">{contactHeading}</h2>
      <p class="mt-3 max-w-2xl text-lg text-muted">{contactText}</p>
      <div class="mt-6">
        <ButtonLink href="/contact/">Let’s talk</ButtonLink>
      </div>
    </section>
  </main>
</BaseLayout>
