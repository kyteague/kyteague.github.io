---
import { getCollection } from "astro:content";
import Hero from "../components/Hero.astro";
import StructuredData from "../components/StructuredData.astro";
import WritingList from "../components/WritingList.astro";
import {
  SITE_AUTHOR,
  SITE_AUTHOR_BIO,
  SITE_AUTHOR_ROLE,
  SITE_AUTHOR_PROFILES,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SITE_TOPICS,
} from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const siteURL = new URL("/", Astro.site).href;
const profileURL = new URL("/about/", Astro.site).href;
const websiteID = new URL("/#website", Astro.site).href;
const personID = new URL("/#person", Astro.site).href;
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteID,
      url: siteURL,
      name: SITE_TITLE,
      alternateName: "kyleteague.com",
      description: SITE_DESCRIPTION,
      inLanguage: "en-US",
      creator: { "@id": personID },
      publisher: { "@id": personID },
    },
    {
      "@type": "Person",
      "@id": personID,
      name: SITE_AUTHOR,
      url: profileURL,
      description: SITE_AUTHOR_BIO,
      jobTitle: SITE_AUTHOR_ROLE,
      knowsAbout: SITE_TOPICS,
      sameAs: SITE_AUTHOR_PROFILES,
    },
  ],
};
---

<BaseLayout
  title={`${SITE_TITLE} — Software Engineer & Fractional CTO`}
  description={SITE_DESCRIPTION}
>
  <StructuredData slot="head" data={siteSchema} />
  <main>
    <Hero />
    <WritingList posts={posts} />
  </main>
</BaseLayout>
