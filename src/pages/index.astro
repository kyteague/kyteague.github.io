---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latestPost = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			{
				latestPost && (
					<article>
						<a href={`/blog/${latestPost.id}/`}>
							{latestPost.data.heroImage && (
								<Image
									width={720}
									height={360}
									src={latestPost.data.heroImage}
									alt=""
								/>
							)}
							<h2>{latestPost.data.title}</h2>
							<p><FormattedDate date={latestPost.data.pubDate} /></p>
							<p>{latestPost.data.description}</p>
						</a>
					</article>
				)
			}
		</main>
		<Footer />
	</body>
</html>
