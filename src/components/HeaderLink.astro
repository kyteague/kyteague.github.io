---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === "/" + (subpath?.[0] || "");
---

<!-- biome-ignore lint/a11y/useAnchorContent: Link text is supplied by the default slot. -->
<a
  href={href}
  class:list={[
    "group inline-flex items-center gap-2 px-2 py-2 text-phosphor no-underline transition-colors hover:text-paper sm:px-3",
    {
      "underline decoration-phosphor/65 decoration-1 underline-offset-[0.45em]":
        isActive,
    },
    className,
  ]}
  aria-current={isActive ? "page" : undefined}
  {...props}
>
  <span class="transition-colors group-hover:text-paper" aria-hidden="true"
    >&gt;</span
  >
  <slot />
</a>
