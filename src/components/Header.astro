---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header class="border-b border-phosphor/20 bg-ink/90 backdrop-blur-sm">
  <nav
    class="site-shell flex min-h-18 flex-col items-start justify-center gap-1 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
    aria-label="Primary navigation"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 font-mono text-sm font-normal tracking-[0.015em] text-phosphor no-underline transition-colors hover:text-paper sm:text-xl"
      aria-label={`${SITE_TITLE}, home`}
    >
      <span aria-hidden="true">&gt;</span>
      <span>{SITE_TITLE}</span>
    </a>

    <div
      class="-mx-2 flex w-[calc(100%+1rem)] items-center justify-between font-mono text-sm font-normal tracking-[0.015em] text-phosphor sm:mx-0 sm:-mr-3 sm:w-auto sm:justify-start sm:gap-4 sm:text-base lg:gap-10 lg:text-xl"
    >
      <HeaderLink href="/blog/">Writing</HeaderLink>
      <HeaderLink href="/about/">About</HeaderLink>
      <a
        href="https://www.linkedin.com/in/kyleteague"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 px-2 py-2 text-phosphor no-underline transition-colors hover:text-paper sm:px-3"
      >
        <span aria-hidden="true">&gt;</span> Contact
      </a>
    </div>
  </nav>
</header>
