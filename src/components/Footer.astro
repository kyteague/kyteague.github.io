---
const today = new Date();
---

<footer id="contact" class="border-t border-phosphor/20 bg-panel/45">
  <div class="site-shell flex flex-col gap-3 py-8 sm:items-end">
    <div
      class="flex gap-5 font-mono text-xs tracking-[0.08em] text-phosphor uppercase"
    >
      <a
        class="transition hover:text-phosphor-bright"
        href="https://github.com/kyteague"
        target="_blank"
        rel="me noreferrer">GitHub</a
      >
      <a
        class="transition hover:text-phosphor-bright"
        href="https://twitter.com/kyteague"
        target="_blank"
        rel="me noreferrer">X / Twitter</a
      >
      <a
        class="transition hover:text-phosphor-bright"
        href="https://www.linkedin.com/in/kyleteague"
        target="_blank"
        rel="me noreferrer">LinkedIn</a
      >
    </div>
    <p class="font-mono text-[0.65rem] tracking-[0.08em] text-muted uppercase">
      © {today.getFullYear()} Kyle Teague
    </p>
  </div>
</footer>
