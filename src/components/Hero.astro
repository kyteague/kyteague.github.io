---
import ButtonLink from "./ButtonLink.astro";
---

<section
  id="about"
  class="site-shell border-b border-phosphor/20 pt-12 pb-12 sm:pt-14 sm:pb-12"
>
  <div class="max-w-[80rem]">
    <h1
      class="max-w-[15ch] text-[clamp(3rem,4.25vw,4.25rem)] font-normal leading-[1.12] text-paper"
    >
      Software engineer &amp;<br />fractional CTO<span class="text-phosphor"
        >.</span
      >
    </h1>

    <div class="mt-4">
      <p
        class="max-w-2xl text-pretty text-lg leading-relaxed text-muted sm:text-[1.35rem]"
      >
        I design systems, lead technical teams, and help companies make
        difficult technology decisions.
      </p>
      <div class="mt-7 flex">
        <ButtonLink
          href="https://www.linkedin.com/in/kyleteague"
          target="_blank"
          rel="noreferrer"
          indicator="cursor"
        >
          More about me
        </ButtonLink>
      </div>
    </div>
  </div>
</section>
