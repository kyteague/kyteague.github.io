---
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  openGraphType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  authorURL?: string;
  tags?: string[];
  twitterCreator?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  openGraphType,
  publishedTime,
  modifiedTime,
  authorURL,
  tags,
  twitterCreator,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      openGraphType={openGraphType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      authorURL={authorURL}
      tags={tags}
      twitterCreator={twitterCreator}
    />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
